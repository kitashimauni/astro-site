---
import Head from "@components/util/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/util/Footer.astro";
import {
    getTechnology,
} from "@data/technologies";
import {
    getUsedTechnologies,
    workStatusLabels,
    works,
} from "@data/portfolio";
import "@styles/default.css";

const usedTechnologies = getUsedTechnologies();
---

<style>
    main {
        max-width: 960px;
        margin: 0 auto;
        padding: 48px 24px 80px;
        color: #1f2937;
    }
    h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: 12px;
    }
    .lead {
        font-size: 1.05rem;
        line-height: 1.8;
        margin-bottom: 32px;
    }
    .section-title {
        font-size: 1.4rem;
        margin-bottom: 16px;
    }
    .work-list {
        display: grid;
        gap: 16px;
        padding: 0;
        list-style: none;
    }
    .work-item {
        border: 1px solid #d1d5db;
        border-radius: 12px;
        padding: 20px;
        background: #fff;
    }
    .work-head {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: baseline;
        margin-bottom: 8px;
    }
    .work-head h2 {
        font-size: 1.15rem;
        margin: 0;
    }
    .status {
        font-size: 0.9rem;
        color: #4b5563;
    }
    .work-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-bottom: 8px;
        color: #4b5563;
        font-size: 0.9rem;
    }
    .technology-list,
    .link-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0;
        list-style: none;
    }
    .technology-list {
        margin: 16px 0 0;
    }
    .technology-list li {
        padding: 4px 10px;
        border-radius: 999px;
        background: #ecfdf5;
        color: #166534;
        font-size: 0.85rem;
    }
    .link-list {
        margin: 14px 0 0;
    }
    .link-list a {
        color: #166534;
        font-weight: 600;
    }
    .stack {
        margin-top: 48px;
    }
    .stack-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        padding: 0;
        list-style: none;
    }
    .stack-list li {
        padding: 14px 16px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        background: #f8fafc;
    }
    .stack-list strong,
    .stack-list span {
        display: block;
    }
    .stack-list span {
        margin-top: 4px;
        color: #4b5563;
        font-size: 0.85rem;
    }
    p {
        margin: 0;
        line-height: 1.7;
    }
</style>

<html lang="ja">
    <Head
        title="Portfolio"
        description="制作物や取り組みをまとめたページです"
    />
    <body>
        <Header />
        <main>
            <h1>Portfolio</h1>
            <p class="lead">
                研究・制作物をプロジェクト単位でまとめています。
            </p>

            <section>
                <h2 class="section-title">制作物一覧</h2>
                <ul class="work-list">
                    {
                        works.map((work) => (
                            <li class="work-item" id={`work-${work.id}`}>
                                <div class="work-head">
                                    <h2>{work.title}</h2>
                                    <span class="status">
                                        {workStatusLabels[work.status]}
                                    </span>
                                </div>
                                <div class="work-meta">
                                    <span>{work.category}</span>
                                    {work.period && <span>{work.period}</span>}
                                </div>
                                <p>{work.summary}</p>
                                <ul class="technology-list" aria-label="使用技術">
                                    {work.technologies.map((technologyId) => (
                                        <li>{getTechnology(technologyId).name}</li>
                                    ))}
                                </ul>
                                {work.links && work.links.length > 0 && (
                                    <ul class="link-list" aria-label="関連リンク">
                                        {work.links.map((link) => (
                                            <li>
                                                <a
                                                    href={link.url}
                                                    target="_blank"
                                                    rel="noreferrer"
                                                >
                                                    {link.label ?? link.type}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="stack">
                <h2 class="section-title">Technical Stack</h2>
                <ul class="stack-list">
                    {usedTechnologies.map((technology) => (
                        <li>
                            <strong>{technology.name}</strong>
                            <span>{technology.category}</span>
                        </li>
                    ))}
                </ul>
            </section>
        </main>
        <Footer />
    </body>
</html>
