---
import Head from "@components/util/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/util/Footer.astro";
import {
    getTechnology,
} from "@data/technologies";
import {
    getTechnologyWorkCount,
    getUsedTechnologiesByCategory,
    getWorkStatusLabel,
    works,
} from "@data/portfolio";
import "@styles/default.css";

const usedTechnologyGroups = getUsedTechnologiesByCategory();
---

<style>
    main {
        max-width: 960px;
        margin: 0 auto;
        padding: 48px 24px 80px;
        color: #1f2937;
    }
    h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: 12px;
    }
    .lead {
        font-size: 1.05rem;
        line-height: 1.8;
        margin-bottom: 32px;
    }
    .section-title {
        font-size: 1.4rem;
        margin-bottom: 16px;
    }
    .work-list {
        display: grid;
        gap: 16px;
        padding: 0;
        list-style: none;
    }
    .work-item {
        border: 1px solid #d1d5db;
        border-radius: 12px;
        padding: 20px;
        background: #fff;
    }
    .work-head {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: baseline;
        margin-bottom: 8px;
    }
    .work-head h2 {
        font-size: 1.15rem;
        margin: 0;
    }
    .status {
        font-size: 0.9rem;
        color: #4b5563;
    }
    .work-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-bottom: 8px;
        color: #4b5563;
        font-size: 0.9rem;
    }
    .technology-list,
    .link-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0;
        list-style: none;
    }
    .technology-list {
        margin: 16px 0 0;
    }
    .technology-list li {
        display: flex;
    }
    .technology-list button,
    .filter-reset,
    .stack-list button {
        border: 0;
        border-radius: 999px;
        padding: 6px 10px;
        background: #ecfdf5;
        color: #166534;
        font: inherit;
        font-size: 0.85rem;
        cursor: pointer;
    }
    .technology-list button:hover,
    .technology-list button:focus-visible,
    .stack-list button:hover,
    .stack-list button:focus-visible,
    .filter-reset:hover,
    .filter-reset:focus-visible {
        background: #d1fae5;
    }
    .technology-list button[aria-pressed="true"],
    .stack-list button[aria-pressed="true"] {
        box-shadow: 0 0 0 2px #166534;
        background: #bbf7d0;
    }
    .link-list {
        margin: 14px 0 0;
    }
    .link-list a {
        color: #166534;
        font-weight: 600;
    }
    .stack {
        margin: 32px 0 48px;
        padding: 24px;
        border: 1px solid #d1d5db;
        border-radius: 12px;
        background: #f8fafc;
    }
    .stack-description {
        margin-bottom: 16px;
        color: #4b5563;
    }
    .stack-groups {
        display: grid;
        gap: 20px;
    }
    .stack-group h3 {
        margin: 0 0 8px;
        font-size: 1rem;
    }
    .stack-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0;
        list-style: none;
    }
    .stack-list button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #bbf7d0;
        background: #fff;
    }
    .stack-list button span {
        color: #4b5563;
        font-size: 0.8rem;
    }
    .filter-status {
        min-height: 1.5em;
        margin-top: 20px;
        color: #4b5563;
        font-size: 0.85rem;
    }
    .filter-reset {
        border-radius: 6px;
        background: #e5e7eb;
        color: #1f2937;
    }
    .work-list [hidden] {
        display: none;
    }
    button:focus-visible {
        outline: 3px solid #86efac;
        outline-offset: 2px;
    }
    p {
        margin: 0;
        line-height: 1.7;
    }
</style>

<html lang="ja">
    <Head
        title="Portfolio"
        description="制作物や取り組みをまとめたページです"
    />
    <body>
        <Header />
        <main>
            <h1>Portfolio</h1>
            <p class="lead">
                研究・制作物をプロジェクト単位でまとめています。
            </p>

            <section class="stack" aria-labelledby="stack-title">
                <h2 id="stack-title" class="section-title">Technical Stack</h2>
                <p class="stack-description">
                    技術を選ぶと、その技術を使った制作物に絞り込めます。
                </p>
                <button
                    type="button"
                    class="filter-reset"
                    data-technology-filter="all"
                    aria-pressed="true"
                >
                    すべて表示
                </button>
                <div class="stack-groups">
                    {
                        usedTechnologyGroups.map((group) => (
                            <section class="stack-group">
                                <h3>{group.category}</h3>
                                <ul class="stack-list">
                                    {group.technologies.map((technology) => (
                                        <li>
                                            <button
                                                type="button"
                                                data-technology-filter={technology.id}
                                                data-technology-name={technology.name}
                                                aria-pressed="false"
                                            >
                                                {technology.name}
                                                <span>
                                                    {getTechnologyWorkCount(technology.id)}作品
                                                </span>
                                            </button>
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        ))
                    }
                </div>
                <p class="filter-status" data-filter-status aria-live="polite">
                    全{works.length}作品を表示中
                </p>
            </section>

            <section aria-labelledby="works-title">
                <h2 id="works-title" class="section-title">制作物一覧</h2>
                <ul class="work-list" id="portfolio-works">
                    {
                        works.map((work) => (
                            <li
                                class="work-item"
                                id={`work-${work.id}`}
                                data-work-item
                                data-technologies={work.technologies.join(" ")}
                            >
                                <div class="work-head">
                                    <h2>{work.title}</h2>
                                    <span class="status">
                                        {getWorkStatusLabel(work)}
                                    </span>
                                </div>
                                <div class="work-meta">
                                    <span>{work.category}</span>
                                    {work.period && <span>{work.period}</span>}
                                </div>
                                <p>{work.summary}</p>
                                <ul class="technology-list" aria-label="使用技術">
                                    {work.technologies.map((technologyId) => (
                                        <li>
                                            <button
                                                type="button"
                                                data-technology-filter={technologyId}
                                                data-technology-name={getTechnology(technologyId).name}
                                                aria-pressed="false"
                                            >
                                                {getTechnology(technologyId).name}
                                            </button>
                                        </li>
                                    ))}
                                </ul>
                                {work.links && work.links.length > 0 && (
                                    <ul class="link-list" aria-label="関連リンク">
                                        {work.links.map((link) => (
                                            <li>
                                                <a
                                                    href={link.url}
                                                    target="_blank"
                                                    rel="noreferrer"
                                                >
                                                    {link.label ?? link.type}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </li>
                        ))
                    }
                </ul>
            </section>
        </main>
        <Footer />
    </body>
</html>

<script>
    const workItems = Array.from(
        document.querySelectorAll<HTMLElement>("[data-work-item]"),
    );
    const filterButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
            "[data-technology-filter]",
        ),
    );
    const filterStatus = document.querySelector<HTMLElement>(
        "[data-filter-status]",
    );

    const applyTechnologyFilter = (technologyId: string): void => {
        const isAll = technologyId === "all";
        let visibleCount = 0;
        let technologyName = "";

        for (const button of filterButtons) {
            const isActive = button.dataset.technologyFilter === technologyId;
            button.setAttribute("aria-pressed", String(isActive));
            if (isActive && button.dataset.technologyName) {
                technologyName = button.dataset.technologyName;
            }
        }

        for (const item of workItems) {
            const technologies = item.dataset.technologies?.split(" ") ?? [];
            const isVisible = isAll || technologies.includes(technologyId);
            item.hidden = !isVisible;
            if (isVisible) {
                visibleCount += 1;
            }
        }

        if (filterStatus) {
            filterStatus.textContent = isAll
                ? `全${visibleCount}作品を表示中`
                : `${technologyName}を使用する${visibleCount}作品を表示中`;
        }
    };

    for (const button of filterButtons) {
        button.addEventListener("click", () => {
            applyTechnologyFilter(button.dataset.technologyFilter ?? "all");
        });
    }
</script>
