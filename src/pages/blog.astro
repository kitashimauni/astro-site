---
import Head from "@components/util/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/util/Footer.astro";
import { works } from "@data/portfolio";
import "@styles/default.css";

const blogGuides = [
    {
        id: "technical-blog",
        title: "Tech Blog",
        description:
            "ソフトウェア開発・機械学習・研究など、技術に関する記事を掲載しています。",
        focus: "技術記事・学習記録",
    },
    {
        id: "polaris-observatory",
        title: "ポラリス観測所",
        description:
            "日々の出来事やアニメ・ゲームなど、日常や趣味について書いています。",
        focus: "日常・趣味の記録",
    },
].map((guide) => {
    const work = works.find((item) => item.id === guide.id);
    const website = work?.links?.find((link) => link.type === "Website");
    const github = work?.links?.find((link) => link.type === "GitHub");

    if (!website || !github) {
        throw new Error(`Blog links are missing for ${guide.id}`);
    }

    return {
        ...guide,
        website,
        github,
        domain: new URL(website.url).host,
    };
});
---

<html lang="ja">
    <Head
        title="Blog"
        description="技術ブログと日常ブログへの案内ページです"
    />
    <body>
        <Header />
        <main class="blog-guide">
            <span class="eyebrow">External Blogs</span>
            <h1>Blog</h1>
            <p class="lead">
                読みたい内容に合わせて、技術ブログと日常ブログから行き先を選べます。
            </p>

            <div class="blog-grid">
                {
                    blogGuides.map((guide) => (
                        <article class="blog-card">
                            <p class="blog-focus">{guide.focus}</p>
                            <h2>{guide.title}</h2>
                            <p class="blog-description">{guide.description}</p>
                            <p class="blog-destination">
                                <span>公開先</span>
                                <code>{guide.domain}</code>
                            </p>
                            <div class="blog-actions">
                                <a
                                    href={guide.website.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="blog-btn"
                                >
                                    外部サイトへ移動
                                    <span aria-hidden="true">↗</span>
                                </a>
                                <a
                                    href={guide.github.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="source-link"
                                >
                                    ソースコード（GitHub）
                                    <span aria-hidden="true">↗</span>
                                </a>
                            </div>
                        </article>
                    ))
                }
            </div>
        </main>
        <Footer />
    </body>
</html>

<style>
    .blog-guide {
        max-width: 960px;
        margin: 0 auto;
        padding: 64px 24px 96px;
        color: #1f2937;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: #dcfce7;
        color: #166534;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 16px;
    }

    h1 {
        margin: 0 0 16px;
        font-size: clamp(2rem, 4vw, 3rem);
    }

    .lead {
        max-width: 720px;
        margin: 0 0 36px;
        line-height: 1.9;
    }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }

    .blog-card {
        display: flex;
        flex-direction: column;
        padding: 28px;
        border: 1px solid #d1d5db;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 8px 24px rgb(15 23 42 / 6%);
    }

    .blog-focus {
        margin: 0 0 12px;
        color: #0f766e;
        font-size: 0.9rem;
        font-weight: 700;
    }

    .blog-card h2 {
        margin: 0 0 12px;
        font-size: 1.5rem;
    }

    .blog-description {
        min-height: 3.8em;
        margin: 0 0 20px;
        line-height: 1.8;
    }

    .blog-destination {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: baseline;
        margin: 0 0 24px;
        color: #4b5563;
        font-size: 0.9rem;
    }

    .blog-destination code {
        color: #111827;
        font-family: inherit;
        font-weight: 700;
    }

    .blog-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
        margin-top: auto;
    }

    .blog-btn,
    .source-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .blog-btn {
        padding: 12px 18px;
        border-radius: 999px;
        background: #0f172a;
        color: #ffffff;
        font-weight: 700;
        transition:
            background-color 0.2s ease,
            transform 0.2s ease;
    }

    .blog-btn:hover,
    .blog-btn:focus-visible {
        background: #1e293b;
        transform: translateY(-1px);
    }

    .source-link {
        color: #0f766e;
        font-size: 0.95rem;
        font-weight: 700;
    }

    .source-link:hover,
    .source-link:focus-visible {
        color: #115e59;
        text-decoration: underline;
    }

    @media (max-width: 720px) {
        .blog-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
