---
import Card from "@components/Card.astro";
import Head from "@components/util/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/util/Footer.astro";
import "@styles/default.css";

import githubLogo from "public/img/github-mark.png";
import xLogo from "public/img/logo-black.png";
import iconImage from "public/img/icon.png";
import { Image } from "astro:assets";
---

<style>
	body {
		background:
			radial-gradient(
				circle at top left,
				rgba(220, 252, 231, 0.9),
				transparent 30%
			),
			linear-gradient(180deg, #f8fffb 0%, #ffffff 48%, #f5f7fb 100%);
		min-height: 100vh;
	}
	.hero {
		max-width: 1120px;
		margin: 0 auto;
		padding: 56px 24px 24px;
		display: flex;
		align-items: center;
		gap: 40px;
	}
	.hero-icon {
		flex-shrink: 0;
		width: 140px;
		height: 140px;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid rgba(22, 101, 52, 0.2);
		box-shadow: 0 4px 24px rgba(15, 23, 42, 0.1);
	}
	.hero-text {
		display: grid;
		gap: 16px;
	}
	.hero h1 {
		margin: 0;
		color: #0f172a;
		font-size: clamp(2.4rem, 7vw, 4.8rem);
		line-height: 1.05;
		max-width: 11ch;
	}
	.hero p {
		margin: 0;
		max-width: 720px;
		font-size: 1.05rem;
		line-height: 1.9;
		color: #334155;
	}
	.cardsArea {
		display: grid;
		gap: 50px 100px;
		max-width: 1120px;
		margin: 32px auto 80px;
		padding: 0 24px;
	}
	.logo-container {
		display: flex;
		align-items: center;
		gap: 40px;
		justify-content: center;
		margin: 0 auto 36px;
		padding: 0 24px;
	}
	.logo {
		width: 50px;
		height: 50px;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}
	.logo-link:hover .logo,
	.logo-link:focus-visible .logo {
		transform: translateY(-2px);
		opacity: 0.85;
	}
	@media (min-width: 900px) {
		.cardsArea {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 899px) {
		.cardsArea {
			grid-template-columns: 1fr;
			gap: 24px;
			margin-top: 24px;
			margin-bottom: 56px;
		}
		.hero {
			padding-top: 36px;
			flex-direction: column;
			align-items: flex-start;
		}
		.hero-icon {
			width: 100px;
			height: 100px;
		}
		.logo-container {
			gap: 24px;
		}
	}
</style>
<html lang="ja">
	<Head
		title="Welcome to kitashima.dev"
		description="kitashima.devのトップページ"
	/>
	<body>
		<Header />
		<section class="hero">
			<Image src={iconImage} alt="アイコン" class="hero-icon" />
			<div class="hero-text">
				<h1>kitashima.dev</h1>
				<p>
					制作物、自己紹介、外部リンクを整理しています。工事中です。
				</p>
			</div>
		</section>
		<div class="cardsArea">
			<Card
				href="/blog/"
				title="Blog"
				body="技術ブログ"
			/>
			<Card
				href="/portfolio/"
				title="Portfolio"
				body="制作物・スキルなど"
			/>
			<Card href="/about/" title="About" body="経歴など" />
			<Card href="/others/" title="Others" body="その他リンク等" />
		</div>
		<div class="logo-container">
			<a
				href="/links/github/"
				target="_blank"
				rel="noreferrer"
				class="logo-link"
			>
				<Image src={githubLogo} alt="GitHubのリンク" class="logo" />
			</a>
			<a
				href="/links/x/"
				target="_blank"
				rel="noreferrer"
				class="logo-link"
			>
				<Image src={xLogo} alt="Xのリンク" class="logo" />
			</a>
		</div>
		<Footer />
	</body>
</html>
