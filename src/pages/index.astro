---
import Head from "@components/util/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/util/Footer.astro";
import "@styles/default.css";

import iconImage from "public/img/icon.png";
import { Image } from "astro:assets";
import { profile } from "@data/about";
import { getFeaturedWorks, getWorkStatusLabel } from "@data/portfolio";
import { getLink, getLinkPath } from "@data/links";

const featuredWorks = getFeaturedWorks();
const blogLinks = (["tech-blog", "daily-blog"] as const).map((slug) => ({
	...getLink(slug),
	href: getLinkPath(slug),
}));
const externalLinks = (["github", "x"] as const).map((slug) => ({
	...getLink(slug),
	href: getLinkPath(slug),
}));
---

<style>
	body {
		background:
			radial-gradient(
				circle at top left,
				rgba(220, 252, 231, 0.9),
				transparent 30%
			),
			linear-gradient(180deg, #f8fffb 0%, #ffffff 48%, #f5f7fb 100%);
		min-height: 100vh;
	}
	.home-page {
		max-width: 1120px;
		margin: 0 auto;
		padding: 56px 24px 96px;
		color: #1f2937;
	}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 48px;
		padding: 24px 0 72px;
	}
	.hero-copy {
		max-width: 720px;
	}
	.eyebrow {
		display: inline-flex;
		align-items: center;
		padding: 7px 13px;
		border-radius: 999px;
		background: #dcfce7;
		color: #166534;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.hero h1 {
		margin: 18px 0 8px;
		color: #0f172a;
		font-size: clamp(2.7rem, 8vw, 5.2rem);
		line-height: 1.05;
		letter-spacing: -0.04em;
	}
	.hero-name {
		margin: 0 0 24px;
		color: #64748b;
		font-size: 1.05rem;
		font-weight: 600;
	}
	.hero-lead {
		max-width: 680px;
		margin: 0;
		color: #334155;
		font-size: 1.12rem;
		line-height: 1.9;
	}
	.profile-facts {
		display: grid;
		gap: 6px;
		margin-top: 24px;
		color: #475569;
		font-size: 0.95rem;
		line-height: 1.7;
	}
	.profile-facts span::before {
		content: "";
		display: inline-block;
		width: 7px;
		height: 7px;
		margin: 0 9px 2px 0;
		border-radius: 50%;
		background: #16a34a;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 30px;
	}
	.button,
	.section-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			background-color 0.2s ease,
			color 0.2s ease;
	}
	.button {
		padding: 12px 18px;
		background: #0f172a;
		color: #ffffff;
	}
	.button.secondary {
		background: #ffffff;
		color: #166534;
		border: 1px solid #bbf7d0;
	}
	.button:hover,
	.button:focus-visible,
	.section-link:hover,
	.section-link:focus-visible,
	.guide-link:hover,
	.guide-link:focus-visible {
		transform: translateY(-2px);
	}
	.button:hover,
	.button:focus-visible {
		background: #1e293b;
	}
	.button.secondary:hover,
	.button.secondary:focus-visible {
		background: #f0fdf4;
	}
	.hero-icon {
		width: clamp(150px, 22vw, 220px);
		height: clamp(150px, 22vw, 220px);
		border: 5px solid rgba(22, 101, 52, 0.16);
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 18px 48px rgba(15, 23, 42, 0.12);
	}
	.home-section {
		margin-top: 56px;
	}
	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 20px;
	}
	.section-heading h2,
	.guide-card h2 {
		margin: 12px 0 0;
		color: #0f172a;
		font-size: clamp(1.55rem, 3vw, 2rem);
	}
	.section-link {
		flex-shrink: 0;
		padding: 8px 0;
		color: #166534;
	}
	.featured-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}
	.featured-card,
	.guide-card {
		border: 1px solid #dbe3ea;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.86);
		box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
	}
	.featured-card {
		display: flex;
		flex-direction: column;
		min-height: 220px;
		padding: 22px;
	}
	.work-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		color: #64748b;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}
	.work-meta span + span::before {
		content: "•";
		margin-right: 8px;
		color: #94a3b8;
	}
	.featured-card h3 {
		margin: 16px 0 10px;
		color: #0f172a;
		font-size: 1.15rem;
		line-height: 1.45;
	}
	.featured-card p {
		margin: 0;
		color: #475569;
		line-height: 1.75;
	}
	.work-link {
		margin-top: auto;
		padding-top: 22px;
		color: #166534;
		font-weight: 700;
		text-decoration: none;
	}
	.home-guides {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}
	.guide-card {
		padding: 24px;
	}
	.guide-list {
		display: grid;
		gap: 10px;
		padding: 0;
		margin: 22px 0 0;
		list-style: none;
	}
	.guide-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 14px 0;
		border-bottom: 1px solid #e2e8f0;
		color: #0f172a;
		text-decoration: none;
		transition: transform 0.2s ease;
	}
	.guide-link span {
		display: grid;
		gap: 4px;
	}
	.guide-link strong {
		font-size: 1rem;
	}
	.guide-link small {
		color: #64748b;
		font-size: 0.88rem;
		line-height: 1.5;
	}
	.guide-link b {
		color: #166534;
		font-size: 1.2rem;
	}
	.guide-more {
		display: inline-block;
		margin-top: 16px;
		color: #166534;
		font-weight: 700;
		text-decoration: none;
	}
	@media (max-width: 860px) {
		.featured-grid {
			grid-template-columns: 1fr;
		}
		.featured-card {
			min-height: auto;
		}
	}
	@media (max-width: 680px) {
		.home-page {
			padding-top: 32px;
		}
		.hero {
			grid-template-columns: 1fr;
			gap: 28px;
			padding-bottom: 40px;
		}
		.hero-icon {
			order: -1;
			width: 120px;
			height: 120px;
		}
		.section-heading {
			align-items: start;
			flex-direction: column;
			gap: 8px;
		}
		.home-guides {
			grid-template-columns: 1fr;
		}
	}
</style>

<html lang="ja">
	<Head
		title="kitashima.dev"
		description="北島大輝の研究・制作物・外部リンクをまとめたポートフォリオサイトです。"
	/>
	<body>
		<Header />
		<main class="home-page">
			<section class="hero" aria-labelledby="home-title">
				<div class="hero-copy">
					<span class="eyebrow">Research &amp; Software</span>
					<h1 id="home-title">{profile.name}</h1>
					<p class="hero-name">{profile.nameEn} / kitashima.dev</p>
					<p class="hero-lead">{profile.introduction}</p>
					<div class="profile-facts">
						<span>{profile.affiliation}</span>
						<span>{profile.laboratory}</span>
					</div>
					<div class="hero-actions">
						<a class="button" href="/about/">Aboutを見る <span aria-hidden="true">→</span></a>
						<a class="button secondary" href="/portfolio/">Portfolioを見る <span aria-hidden="true">→</span></a>
					</div>
				</div>
				<Image src={iconImage} alt={`${profile.name}のアイコン`} class="hero-icon" />
			</section>

			<section class="home-section" aria-labelledby="featured-title">
				<div class="section-heading">
					<div>
						<span class="eyebrow">Featured Research / Works</span>
						<h2 id="featured-title">代表的な研究・制作物</h2>
					</div>
					<a class="section-link" href="/portfolio/">すべての制作物を見る <span aria-hidden="true">→</span></a>
				</div>
				<div class="featured-grid">
					{
						featuredWorks.map((work) => (
							<article class="featured-card">
								<div class="work-meta">
									<span>{work.category}</span>
									<span>{getWorkStatusLabel(work)}</span>
								</div>
								<h3>{work.title}</h3>
								<p>{work.summary}</p>
								<a class="work-link" href={`/portfolio/#work-${work.id}`}>
									Portfolioで詳細を見る <span aria-hidden="true">→</span>
								</a>
							</article>
						))
					}
				</div>
			</section>

			<section class="home-section home-guides" aria-label="案内">
				<article class="guide-card">
					<span class="eyebrow">Blog</span>
					<h2>書いたもの・日々の記録</h2>
					<ul class="guide-list">
						{
							blogLinks.map((link) => (
								<li>
									<a
										class="guide-link"
										href={link.href}
										target="_blank"
										rel="noreferrer"
									>
										<span>
											<strong>{link.label}</strong>
											<small>{link.description}</small>
										</span>
										<b aria-hidden="true">↗</b>
									</a>
								</li>
							))
						}
					</ul>
				</article>

				<article class="guide-card">
					<span class="eyebrow">External Links</span>
					<h2>活動場所・プロフィール</h2>
					<ul class="guide-list">
						{
							externalLinks.map((link) => (
								<li>
									<a
										class="guide-link"
										href={link.href}
										target="_blank"
										rel="noreferrer"
									>
										<span>
											<strong>{link.label}</strong>
											<small>{link.description}</small>
										</span>
										<b aria-hidden="true">↗</b>
									</a>
								</li>
							))
						}
					</ul>
					<a class="guide-more" href="/links/">リンク一覧を見る <span aria-hidden="true">→</span></a>
				</article>
			</section>
		</main>
		<Footer />
	</body>
</html>
