---
import Head from "@components/util/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/util/Footer.astro";
import { getFeaturedWorks, workStatusLabels } from "@data/portfolio";
import { getTechnology } from "@data/technologies";
import "@styles/default.css";

const featuredWorks = getFeaturedWorks();
const featuredTechnologyIds = [
	...new Set(featuredWorks.flatMap((work) => work.technologies)),
];
---

<style>
	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 48px 24px 80px;
		color: #1f2937;
	}
	h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 12px;
	}
	.lead {
		font-size: 1.05rem;
		line-height: 1.8;
		margin-bottom: 32px;
	}
	.section {
		margin-top: 32px;
	}
	.section h2 {
		font-size: 1.35rem;
		margin-bottom: 12px;
	}
	.section p {
		line-height: 1.8;
	}
	.skill-list {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.skill-list li {
		padding: 10px 14px;
		border-radius: 999px;
		background: #e5f7ea;
		color: #14532d;
		font-weight: 600;
	}
	.work-list {
		display: grid;
		gap: 10px;
		padding: 0;
		list-style: none;
	}
	.work-list li {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 0;
		border-bottom: 1px solid #e5e7eb;
	}
	.work-list a {
		color: #166534;
		font-weight: 700;
	}
	.work-status {
		color: #4b5563;
		font-size: 0.9rem;
	}
</style>

<html lang="ja">
	<Head title="About" description="自己紹介とスキルの概要です" />
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<p class="lead">
				自己紹介ページです。
			</p>

			<section class="section">
				<h2>プロフィール</h2>
				<p>
					東京農工大学大学院工学府知能情報システム工学専攻に所属しています。ゲーム製作や競技プログラミング等様々な活動をしています。
				</p>
			</section>

			<section class="section">
				<h2>関心分野</h2>
				<p>
					ゲーム製作、競技プログラミング、CTF、WEB制作などなど
				</p>
			</section>

			<section class="section">
				<h2>主な制作物</h2>
				<ul class="work-list">
					{
						featuredWorks.map((work) => (
							<li>
								<a href={`/portfolio/#work-${work.id}`}>
									{work.title}
								</a>
								<span class="work-status">
									{workStatusLabels[work.status]}
								</span>
							</li>
						))
					}
				</ul>
			</section>

			<section class="section">
				<h2>使用技術</h2>
				<ul class="skill-list">
					{featuredTechnologyIds.map((technologyId) => (
						<li>{getTechnology(technologyId).name}</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
