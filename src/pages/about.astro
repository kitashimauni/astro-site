---
import Head from "@components/util/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/util/Footer.astro";
import {
    achievements,
    activities,
    hobbies,
    profile,
    researchInterests,
    timeline,
} from "@data/about";
import { getFeaturedWorks, getWorkStatusLabel } from "@data/portfolio";
import "@styles/default.css";

const featuredWorks = getFeaturedWorks();
const educationTimeline = timeline.filter(
    (entry) => entry.section === "Education",
);
const experienceTimeline = timeline.filter(
    (entry) => entry.section === "Experience",
);
---

<style>
    main {
        max-width: 960px;
        margin: 0 auto;
        padding: 48px 24px 80px;
        color: #1f2937;
    }
    h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: 12px;
    }
    h2 {
        font-size: 1.35rem;
        margin: 0 0 16px;
    }
    h3 {
        font-size: 1rem;
        margin: 0;
    }
    .lead {
        max-width: 760px;
        font-size: 1.05rem;
        line-height: 1.9;
        margin-bottom: 32px;
    }
    .section {
        margin-top: 40px;
    }
    .section-note {
        color: #4b5563;
        line-height: 1.8;
    }
    .profile-card {
        padding: 20px;
        border: 1px solid #d1d5db;
        border-radius: 12px;
        background: #f8fafc;
    }
    .profile-name {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
    }
    .profile-name span {
        color: #4b5563;
        font-size: 0.95rem;
        font-weight: 500;
    }
    .profile-details {
        display: grid;
        gap: 6px;
        margin: 12px 0 0;
    }
    .profile-details p {
        margin: 0;
        line-height: 1.7;
    }
    .profile-details a,
    .item-links a,
    .work-list a {
        color: #166534;
        font-weight: 700;
    }
    .card-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 12px;
        padding: 0;
        list-style: none;
    }
    .card-list li {
        padding: 16px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #fff;
    }
    .card-list p {
        margin: 8px 0 0;
        color: #4b5563;
        line-height: 1.7;
    }
    .timeline-groups {
        display: grid;
        gap: 24px;
    }
    .timeline-group h3 {
        margin-bottom: 10px;
        color: #14532d;
    }
    .timeline {
        display: grid;
        gap: 12px;
        padding: 0;
        list-style: none;
    }
    .timeline-entry {
        display: grid;
        grid-template-columns: 100px 1fr;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid #e5e7eb;
    }
    .timeline-period,
    .item-period {
        color: #166534;
        font-size: 0.9rem;
        font-weight: 700;
    }
    .timeline-organization,
    .item-description {
        margin: 6px 0 0;
        color: #4b5563;
        line-height: 1.7;
    }
    .item-description {
        color: #374151;
    }
    .item-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        padding: 0;
        margin: 10px 0 0;
        list-style: none;
    }
    .work-list {
        display: grid;
        gap: 10px;
        padding: 0;
        list-style: none;
    }
    .work-list li {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 0;
        border-bottom: 1px solid #e5e7eb;
    }
    .work-status {
        color: #4b5563;
        font-size: 0.9rem;
    }
    @media (max-width: 640px) {
        .timeline-entry {
            grid-template-columns: 1fr;
            gap: 6px;
        }
        .work-list li {
            display: grid;
            gap: 4px;
        }
    }
</style>

<html lang="ja">
    <Head
        title="About"
        description="プロフィール、研究関心、経歴、実績、趣味を紹介します"
    />
    <body>
        <Header />
        <main>
            <h1>About</h1>
            <p class="lead">{profile.introduction}</p>

            <section class="section">
                <h2>プロフィール / Profile</h2>
                <div class="profile-card">
                    <p class="profile-name">
                        {profile.name}
                        <span> / {profile.nameEn}</span>
                    </p>
                    <div class="profile-details">
                        <p>{profile.affiliation}</p>
                        <p>
                            <a
                                href="https://katfuji.lab.tuat.ac.jp/member.html"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                {profile.laboratory}
                            </a>
                        </p>
                    </div>
                </div>
            </section>

            <section class="section">
                <h2>研究関心 / Research Interests</h2>
                <ul class="card-list">
                    {researchInterests.map((interest) => (
                        <li>
                            <h3>{interest.title}</h3>
                            <p>{interest.description}</p>
                        </li>
                    ))}
                </ul>
            </section>

            <section class="section">
                <h2>学歴・研究経験 / Education & Experience</h2>
                <p class="section-note">
                    経歴の年月は本人確認済みの情報を掲載しています。
                </p>
                <div class="timeline-groups">
                    {[
                        { title: "Education", entries: educationTimeline },
                        { title: "Experience", entries: experienceTimeline },
                    ].map((group) => (
                        <div class="timeline-group">
                            <h3>{group.title}</h3>
                            <ol class="timeline">
                                {group.entries.map((entry) => (
                                    <li class="timeline-entry">
                                        <div class="timeline-period">
                                            {entry.period}
                                        </div>
                                        <div>
                                            <h3>{entry.title}</h3>
                                            {entry.organization && (
                                                <p class="timeline-organization">
                                                    {entry.organization}
                                                </p>
                                            )}
                                            <p class="item-description">
                                                {entry.description}
                                            </p>
                                            {entry.links &&
                                                entry.links.length > 0 && (
                                                    <ul class="item-links">
                                                        {entry.links.map((link) => (
                                                            <li>
                                                                <a
                                                                    href={link.url}
                                                                    target="_blank"
                                                                    rel="noopener noreferrer"
                                                                >
                                                                    {link.label}
                                                                </a>
                                                            </li>
                                                        ))}
                                                    </ul>
                                                )}
                                        </div>
                                    </li>
                                ))}
                            </ol>
                        </div>
                    ))}
                </div>
            </section>

            <section class="section">
                <h2>実績 / Achievements</h2>
                <ul class="card-list">
                    {achievements.map((item) => (
                        <li>
                            {item.period && (
                                <div class="item-period">{item.period}</div>
                            )}
                            <h3>{item.title}</h3>
                            <p class="item-description">{item.description}</p>
                            {item.links && item.links.length > 0 && (
                                <ul class="item-links">
                                    {item.links.map((link) => (
                                        <li>
                                            <a
                                                href={link.url}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                {link.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </li>
                    ))}
                </ul>
            </section>

            <section class="section">
                <h2>活動 / Activities</h2>
                <ul class="card-list">
                    {activities.map((item) => (
                        <li>
                            {item.period && (
                                <div class="item-period">{item.period}</div>
                            )}
                            <h3>{item.title}</h3>
                            <p class="item-description">{item.description}</p>
                            {item.links && item.links.length > 0 && (
                                <ul class="item-links">
                                    {item.links.map((link) => (
                                        <li>
                                            <a
                                                href={link.url}
                                                target={
                                                    link.url.startsWith("http")
                                                        ? "_blank"
                                                        : undefined
                                                }
                                                rel={
                                                    link.url.startsWith("http")
                                                        ? "noopener noreferrer"
                                                        : undefined
                                                }
                                            >
                                                {link.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </li>
                    ))}
                </ul>
            </section>

            <section class="section">
                <h2>趣味・関心 / Hobbies & Interests</h2>
                <ul class="card-list">
                    {hobbies.map((hobby) => (
                        <li>
                            <h3>{hobby.title}</h3>
                            <p>{hobby.description}</p>
                        </li>
                    ))}
                </ul>
            </section>

            <section class="section">
                <h2>主な制作物</h2>
                <ul class="work-list">
                    {featuredWorks.map((work) => (
                        <li>
                            <a href={`/portfolio/#work-${work.id}`}>
                                {work.title}
                            </a>
                            <span class="work-status">
                                {getWorkStatusLabel(work)}
                            </span>
                        </li>
                    ))}
                </ul>
            </section>
        </main>
        <Footer />
    </body>
</html>
