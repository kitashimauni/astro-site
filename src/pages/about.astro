---
import Head from "@components/util/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/util/Footer.astro";
import "@styles/default.css";

const skills = ["C", "Python", "Web 開発", "アルゴリズム", "機械学習"];
---

<style>
	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 48px 24px 80px;
		color: #1f2937;
	}
	h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 12px;
	}
	.lead {
		font-size: 1.05rem;
		line-height: 1.8;
		margin-bottom: 32px;
	}
	.section {
		margin-top: 32px;
	}
	.section h2 {
		font-size: 1.35rem;
		margin-bottom: 12px;
	}
	.section p {
		line-height: 1.8;
	}
	.skill-list {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.skill-list li {
		padding: 10px 14px;
		border-radius: 999px;
		background: #e5f7ea;
		color: #14532d;
		font-weight: 600;
	}
</style>

<html lang="ja">
	<Head title="About" description="自己紹介とスキルの概要です" />
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<p class="lead">
				自己紹介ページです。
			</p>

			<section class="section">
				<h2>プロフィール</h2>
				<p>
					東京農工大学大学院工学府知能情報システム工学専攻に所属しています。ゲーム製作や競技プログラミング等様々な活動をしています。
				</p>
			</section>

			<section class="section">
				<h2>関心分野</h2>
				<p>
					ゲーム製作、競技プログラミング、CTF、WEB制作などなど
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
