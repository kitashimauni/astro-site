---
import { linkEntries } from "@data/links";

export function getStaticPaths() {
	return linkEntries.map((link) => ({
		params: { service: link.slug },
		props: { destination: link.destination },
	}));
}

interface Props {
	destination: (typeof linkEntries)[number]["destination"];
}

return Astro.redirect(Astro.props.destination, 307);
---
