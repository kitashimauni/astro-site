---
import Head from "@components/util/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/util/Footer.astro";
import "@styles/default.css";

const links = [
    {
        label: "GitHub",
        href: "https://github.com/kitashimauni",
        description: "コードや個人開発の成果物をまとめています。",
    },
    {
        label: "X",
        href: "https://x.com/nibs_tuat",
        description: "更新情報や日々のメモを発信しています。",
    },
    {
        label: "Tech Blog",
        href: "https://tech.n-island.dev",
        description: "技術記事や学習ログを掲載しています。",
    },
    {
        label: "AtCoder",
        href: "https://atcoder.jp/users/nigs",
        description: "AtCoderのプロフィールです。"
    }
];
---

<style>
    main {
        max-width: 960px;
        margin: 0 auto;
        padding: 48px 24px 80px;
        color: #1f2937;
    }
    h1 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin-bottom: 12px;
    }
    .lead {
        font-size: 1.05rem;
        line-height: 1.8;
        margin-bottom: 32px;
    }
    .link-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 16px;
    }
    .link-list li {
        border: 1px solid #d1d5db;
        border-radius: 12px;
        padding: 20px;
        background: #fff;
    }
    .link-list a {
        color: #0f766e;
        font-weight: 700;
        text-decoration: none;
    }
    .link-list p {
        margin: 10px 0 0;
        line-height: 1.7;
    }
</style>

<html lang="ja">
    <Head title="Others" description="その他のリンクや補足情報のページです" />
    <body>
        <Header />
        <main>
            <h1>Others</h1>
            <p class="lead">
                外部リンク等
            </p>

            <ul class="link-list">
                {
                    links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                target="_blank"
                                rel="noreferrer"
                            >
                                {link.label}
                            </a>
                            <p>{link.description}</p>
                        </li>
                    ))
                }
            </ul>
        </main>
        <Footer />
    </body>
</html>
